# Canonical origin. Used for metadata, hreflang, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.liquilob.com

# ---------------------------------------------------------------- ADMIN PANEL
# /admin is behind HTTP Basic auth. With ADMIN_PASSWORD unset the panel refuses
# to serve at all, so forgetting to set it fails closed rather than open.
ADMIN_USER=admin
ADMIN_PASSWORD=

# ------------------------------------------------------------------ ANALYTICS
# Where the event log lives. With neither set it is held in memory and is lost
# on restart; the admin panel says so rather than showing numbers that reset.
#
#   Own server:  a writable directory, one JSONL file per month
# ANALYTICS_DATA_DIR=/var/lib/liquilob
#
#   Vercel or any serverless host: Upstash Redis over REST
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ------------------------------------------------------- INQUIRY FORWARDING
# Email. Dormant until Profimann's mailbox exists: with these unset the form
# still works and inquiries collect in /admin, flagged as not yet forwarded.
# Set all three to switch forwarding on.
INQUIRY_TO_EMAIL=
INQUIRY_FROM_EMAIL=
RESEND_API_KEY=

# Webhook, as an alternative or a backup to email. A CRM intake endpoint,
# Zapier, Make, or a Slack or Teams incoming webhook.
INQUIRY_WEBHOOK_URL=

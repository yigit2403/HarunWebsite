# The site is exported as static files, so everything here is read at BUILD
# time and baked into the output. Changing one of these means rebuilding and
# re-uploading — there is no running process to restart.

# Canonical origin. Used for metadata, hreflang, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://www.liquilob.com

# ------------------------------------------------------------------- INDEXING
# robots.txt only lets crawlers in when the build is production AND has been
# told its real address, so a review copy cannot be indexed by accident. Set
# this for a real deployment; leave it unset for a review build.
SITE_STAGE=production

# ------------------------------------------------------------ INQUIRY HANDLER
# Where the contact form posts. Defaults to /inquiry.php, the script uploaded
# alongside the site. Only worth setting to point local development at a PHP
# handler that is already running somewhere.
# NEXT_PUBLIC_INQUIRY_ENDPOINT=/inquiry.php

# ---------------------------------------------------------------------- EMAIL
# NOT set here. The mailbox address lives on the server, in the inquiry.php
# config block or in an inquiry-config.php beside it, because it must be
# changeable without a rebuild. See README, "Deploying to cPanel".
